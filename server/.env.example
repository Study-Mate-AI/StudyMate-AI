MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net
JWT_SECRET=change-me-to-a-long-random-string
# One key, or a pool: key1,key2,key3 (each from a different Google project)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PACK_CREDITS=50000
PRO_CREDITS=200000
# Password reset email. Without SMTP_URL the reset link is printed to the server console.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM=StudyMate <no-reply@yourdomain.com>
# APP_URL=http://localhost:5173
# Google sign-in: OAuth Web client ID
GOOGLE_CLIENT_ID=
# Razorpay (card, UPI, UPI QR). Test keys: dashboard.razorpay.com → Test mode → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
PACK_PRICE_INR=399
PRO_PRICE_INR=749
